# Raw provided data (inputs; supplied by platform at runtime)
/dataset/
**/dataset/public/*.csv

# Experiment artifacts / caches / trained weights (regenerated by solution.py)
**/artifacts/
*.pt
*.pth
*.ckpt
*.npz
*.npy

# Working outputs, except the final canonical submission
**/working/*
!**/working/.gitkeep
!**/working/submission.csv

# OOF / experiment prediction dumps
**/oof/
**/preds/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
env/

# OS / editor
.DS_Store
Thumbs.db
*.swp
